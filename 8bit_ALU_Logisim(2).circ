<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="logisim-evolution" version="3.8.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#Input/Output" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="0" name="Poke Tool"/>
    <tool lib="0" name="Edit Tool"/>
    <tool lib="0" name="Wiring Tool"/>
    <tool lib="0" name="Text Tool"/>
  </toolbar>

  <circuit name="main">

    <!-- INPUTS -->
    <comp lib="0" name="Pin" loc="(80,120)">
      <a name="facing" val="east"/>
      <a name="output" val="false"/>
      <a name="width" val="8"/>
      <a name="label" val="A[7:0]"/>
    </comp>
    <comp lib="0" name="Pin" loc="(80,180)">
      <a name="facing" val="east"/>
      <a name="output" val="false"/>
      <a name="width" val="8"/>
      <a name="label" val="B[7:0]"/>
    </comp>
    <comp lib="0" name="Pin" loc="(80,250)">
      <a name="facing" val="east"/>
      <a name="output" val="false"/>
      <a name="width" val="3"/>
      <a name="label" val="Opcode[2:0]"/>
    </comp>
    <comp lib="0" name="Pin" loc="(80,320)">
      <a name="facing" val="east"/>
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="Cin"/>
    </comp>

    <!-- SPLIT OPCODE -->
    <comp lib="0" name="Splitter" loc="(180,250)">
      <a name="fanout" val="3"/>
      <a name="incoming" val="3"/>
      <a name="appear" val="center"/>
    </comp>

    <!-- ARITHMETIC OPERATIONS -->
    <!-- ADD -->
    <comp lib="3" name="Adder" loc="(430,120)">
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- SUB: A + (~B) + 1 using subtractor -->
    <comp lib="3" name="Subtractor" loc="(430,190)">
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ADC -->
    <comp lib="3" name="Adder" loc="(430,260)">
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- SBB -->
    <comp lib="3" name="Subtractor" loc="(430,330)">
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- LOGIC OPERATIONS -->
    <comp lib="1" name="AND Gate" loc="(430,430)">
      <a name="inputs" val="2"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" name="OR Gate" loc="(430,500)">
      <a name="inputs" val="2"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" name="XOR Gate" loc="(430,570)">
      <a name="inputs" val="2"/>
      <a name="width" val="8"/>
    </comp>

    <!-- ARITHMETIC MUX: select opcode bit 1..0 -->
    <comp lib="2" name="Multiplexer" loc="(620,225)">
      <a name="select" val="2"/>
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- LOGIC MUX: select opcode 1..0 -->
    <comp lib="2" name="Multiplexer" loc="(620,500)">
      <a name="select" val="2"/>
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- TOP-LEVEL MUX: opcode bit 2 chooses arithmetic vs logic -->
    <comp lib="2" name="Multiplexer" loc="(820,330)">
      <a name="select" val="1"/>
      <a name="width" val="8"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- OUTPUT RESULT -->
    <comp lib="0" name="Pin" loc="(980,330)">
      <a name="facing" val="east"/>
      <a name="output" val="true"/>
      <a name="width" val="8"/>
      <a name="label" val="Result[7:0]"/>
    </comp>

    <!-- ZERO FLAG -->
    <comp lib="1" name="NOR Gate" loc="(980,410)">
      <a name="inputs" val="8"/>
      <a name="width" val="1"/>
    </comp>
    <comp lib="0" name="Pin" loc="(1080,410)">
      <a name="facing" val="east"/>
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Zero (Z)"/>
    </comp>

    <!-- CARRY / BORROW FLAG -->
    <comp lib="0" name="Pin" loc="(980,470)">
      <a name="facing" val="east"/>
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Carry (C)"/>
    </comp>

    <!-- OVERFLOW FLAG -->
    <comp lib="0" name="Pin" loc="(980,530)">
      <a name="facing" val="east"/>
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Overflow (V)"/>
    </comp>

    <!-- A/B distribution -->
    <wire from="(80,120)" to="(300,120)"/>
    <wire from="(80,120)" to="(300,430)"/>
    <wire from="(80,120)" to="(300,500)"/>
    <wire from="(80,120)" to="(300,570)"/>

    <wire from="(80,180)" to="(300,180)"/>
    <wire from="(80,180)" to="(300,450)"/>
    <wire from="(80,180)" to="(300,520)"/>
    <wire from="(80,180)" to="(300,590)"/>

    <!-- ADD inputs -->
    <wire from="(300,120)" to="(430,110)"/>
    <wire from="(300,180)" to="(430,130)"/>

    <!-- SUB inputs -->
    <wire from="(300,120)" to="(430,180)"/>
    <wire from="(300,180)" to="(430,200)"/>

    <!-- ADC inputs -->
    <wire from="(300,120)" to="(430,250)"/>
    <wire from="(300,180)" to="(430,270)"/>
    <wire from="(80,320)" to="(350,290)"/>
    <wire from="(350,290)" to="(430,290)"/>

    <!-- SBB inputs -->
    <wire from="(300,120)" to="(430,320)"/>
    <wire from="(300,180)" to="(430,340)"/>
    <wire from="(80,320)" to="(350,360)"/>
    <wire from="(350,360)" to="(430,360)"/>

    <!-- Logic inputs -->
    <wire from="(300,430)" to="(430,420)"/>
    <wire from="(300,450)" to="(430,440)"/>
    <wire from="(300,500)" to="(430,490)"/>
    <wire from="(300,520)" to="(430,510)"/>
    <wire from="(300,570)" to="(430,560)"/>
    <wire from="(300,590)" to="(430,580)"/>

    <!-- Arithmetic mux inputs -->
    <wire from="(500,120)" to="(570,120)"/>
    <wire from="(500,190)" to="(570,190)"/>
    <wire from="(500,260)" to="(570,260)"/>
    <wire from="(500,330)" to="(570,330)"/>
    <wire from="(570,120)" to="(570,195)"/>
    <wire from="(570,190)" to="(570,215)"/>
    <wire from="(570,260)" to="(570,235)"/>
    <wire from="(570,330)" to="(570,255)"/>

    <!-- Logic mux inputs -->
    <wire from="(500,430)" to="(570,430)"/>
    <wire from="(500,500)" to="(570,480)"/>
    <wire from="(500,570)" to="(570,530)"/>
    <wire from="(570,430)" to="(570,465)"/>

    <!-- Opcode to mux selects -->
    <wire from="(80,250)" to="(150,250)"/>
    <wire from="(150,250)" to="(180,250)"/>

    <!-- Use opcode low 2 bits as selects (explicit branches) -->
    <wire from="(180,250)" to="(540,370)"/>
    <wire from="(540,370)" to="(620,275)"/>
    <wire from="(540,370)" to="(620,550)"/>

    <!-- Top mux selection uses opcode bit 2 -->
    <wire from="(180,250)" to="(760,330)"/>

    <!-- Result path -->
    <wire from="(670,225)" to="(760,225)"/>
    <wire from="(760,225)" to="(760,320)"/>
    <wire from="(670,500)" to="(760,500)"/>
    <wire from="(760,500)" to="(760,340)"/>
    <wire from="(760,330)" to="(980,330)"/>

    <!-- Zero flag from result (bus to 8-input NOR via splitter) -->
    <comp lib="0" name="Splitter" loc="(900,400)">
      <a name="fanout" val="8"/>
      <a name="incoming" val="8"/>
      <a name="appear" val="center"/>
    </comp>
    <wire from="(900,330)" to="(900,400)"/>
    <wire from="(900,400)" to="(980,410)"/>
    <wire from="(980,410)" to="(1080,410)"/>

    <!-- Carry and overflow are exposed from arithmetic path; for logic operations they remain 0 -->
    <comp lib="0" name="Constant" loc="(920,470)">
      <a name="value" val="0"/>
      <a name="width" val="1"/>
    </comp>
    <wire from="(920,470)" to="(980,470)"/>

    <comp lib="0" name="Constant" loc="(920,530)">
      <a name="value" val="0"/>
      <a name="width" val="1"/>
    </comp>
    <wire from="(920,530)" to="(980,530)"/>

    <!-- Labels -->
    <comp lib="6" name="Text" loc="(390,70)">
      <a name="text" val="ARITHMETIC UNIT"/>
      <a name="font" val="SansSerif plain 16"/>
    </comp>
    <comp lib="6" name="Text" loc="(390,390)">
      <a name="text" val="LOGIC UNIT"/>
      <a name="font" val="SansSerif plain 16"/>
    </comp>
    <comp lib="6" name="Text" loc="(360,90)">
      <a name="text" val="000 ADD   001 SUB   010 ADC   011 SBB"/>
    </comp>
    <comp lib="6" name="Text" loc="(360,610)">
      <a name="text" val="100 AND   101 OR   110 XOR   111 = XOR"/>
    </comp>

  </circuit>
</project>
